<IfModule mod_rewrite.c>
RewriteEngine On

# Route clean API paths to the API router, but do not rewrite real files/folders.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/v1(/.*)?$ api/v1/index.php [QSA,L]

# Block access to sensitive files and internal source folders.
RewriteRule \.(sql|log|env|bak|sh|git)$ - [F,L,NC]
RewriteRule ^(includes|config|mail)(/|$) - [F,L,NC]
</IfModule>
